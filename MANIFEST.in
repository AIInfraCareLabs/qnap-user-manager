include LICENSE README.md CHANGELOG.md CONTRIBUTING.md DEVELOPMENT_LOG.md pyproject.toml AGENTS.md
recursive-include qnap_sdk *.py *.json
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests test_*.py run_*.py
recursive-include tests/fixtures *.xml
prune work
prune reports
prune dist
prune discovery
prune .github
exclude .env
recursive-exclude * __pycache__ *.pyc *.har *credentials* nas-session*
